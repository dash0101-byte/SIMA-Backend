<!DOCTYPE html>
<html lang="es">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Recuperar contraseña | SIMA</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css">
    <link rel="stylesheet" href="/css/password.css">
    <link rel="stylesheet" href="/css/menu.css">
</head>

<body>
    <%- include('../partials/menu') %>

    <div class="container">
        <div class="row justify-content-center align-items-center min-vh-75">
            <div class="col-md-6 col-lg-5">
                <!-- Tarjeta principal con efecto glass -->
                <div class="card password-card shadow-lg">
                    
                    <!-- Header con ícono animado -->
                    <div class="card-header text-center">
                        <div class="icon-wrapper">
                            <i class="fas fa-key"></i>
                        </div>
                        <h3>¿Olvidaste tu contraseña?</h3>
                        <p class="text-muted mb-0">No te preocupes, te ayudamos a recuperarla</p>
                    </div>

                    <!-- Body -->
                    <div class="card-body">
                        <p class="text-center text-description">
                            <i class="fas fa-envelope me-2"></i>
                            Ingresa tu correo electrónico y te enviaremos un enlace para crear una nueva contraseña.
                        </p>

                        <!-- Alertas mejoradas -->
                        <% if(error){ %>
                            <div class="alert alert-danger alert-dismissible fade show" role="alert">
                                <i class="fas fa-exclamation-circle me-2"></i>
                                <%= error %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>

                        <% if(exito){ %>
                            <div class="alert alert-success alert-dismissible fade show" role="alert">
                                <i class="fas fa-check-circle me-2"></i>
                                <%= exito %>
                                <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
                            </div>
                        <% } %>

                        <!-- Formulario -->
                        <form action="/forgot-password" method="POST" class="mt-4">
                            <div class="mb-4">
                                <label class="form-label">
                                    <i class="fas fa-envelope me-2"></i>
                                    Correo electrónico
                                </label>
                                <div class="input-group input-group-neon">
                                    <span class="input-group-text">
                                        <i class="fas fa-user"></i>
                                    </span>
                                    <input
                                        type="email"
                                        name="correo"
                                        class="form-control"
                                        placeholder="tucorreo@ejemplo.com"
                                        required
                                    >
                                </div>
                                <small class="text-muted form-text">
                                    Te enviaremos el enlace a este correo
                                </small>
                            </div>

                            <button type="submit" class="btn btn-primary w-100 btn-neon">
                                <i class="fas fa-paper-plane me-2"></i>
                                Enviar enlace de recuperación
                            </button>
                        </form>

                        <!-- Enlace de retorno -->
                        <div class="text-center mt-4">
                            <a href="/login" class="link-back">
                                <i class="fas fa-arrow-left me-2"></i>
                                Volver al inicio de sesión
                            </a>
                        </div>
                    </div>

                    <!-- Footer de la tarjeta -->
                    <div class="card-footer text-center">
                        <small class="text-muted">
                            <i class="fas fa-shield-alt me-1"></i>
                            Tus datos están seguros con nosotros
                        </small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Bootstrap JS (opcional, para alerts) -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
</body>

</html>